# SIMTS V3 - PostgreSQL-first configuration
SECRET_KEY=REPLACE_WITH_A_LONG_RANDOM_SECRET

# PostgreSQL (recommended and used for production)
# Local example:
# DATABASE_URL=postgresql+psycopg://simts_user:YOUR_PASSWORD@127.0.0.1:5432/simts
DATABASE_URL=postgresql+psycopg://simts_user:YOUR_PASSWORD@127.0.0.1:5432/simts

UPLOAD_FOLDER=uploads
BACKUP_FOLDER=backups

FLASK_DEBUG=0
# Keep 0 for local HTTP. Set 1 only after HTTPS is configured.
SESSION_COOKIE_SECURE=0

# For one local process memory:// is fine. For production with multiple workers use Redis.
RATELIMIT_STORAGE_URI=memory://
# RATELIMIT_STORAGE_URI=redis://127.0.0.1:6379/0

WTF_CSRF_TIME_LIMIT=3600
MAX_CONTENT_LENGTH=10485760
MAX_FORM_MEMORY_SIZE=500000
MAX_FORM_PARTS=100

# Set to 1 only behind a trusted reverse proxy.
TRUST_PROXY=0

# Vercel Blob (required in Vercel for certificate/marksheet PDF storage)
# Create a PRIVATE Vercel Blob store and copy its token here.
BLOB_READ_WRITE_TOKEN=
